<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_certificate_analysis">
        <t t-call="ad_jk_links_to_task.certificate_analysis_jk_template">
            <main>

                <t t-foreach="docs" t-as="doc">
                    <div class="page" style="font-size:10px; font-family: Helvetica, sans-serif; line-height: 1.5;overflow: hidden;">
