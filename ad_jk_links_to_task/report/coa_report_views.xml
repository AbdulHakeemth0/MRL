                            </tr>
                            <tr style="border-bottom: 1px solid #dee2e6; border-color: #dee2e6;">
                                <td style="padding: 5px; border: none; background-color: #f2f9fc;">
                                    <strong>Contract No.</strong>
                                </td>
                                <td style="padding: 5px; border: none;">
                                    <p><t t-esc="doc.contract_no"/></p>
                                </td>
                                <td style="padding: 5px; border: none; background-color: #f2f9fc;">
                                    <strong>Contract Date</strong>
                                </td>
                                <td style="padding: 5px; border: none;">
                                    <p><span t-esc="doc.contract_date"/></p>
                                </td>
                            </tr>
                        </table>

                        <div style="margin-top: 25px;">
                            <div>
                                <h6>
                                    <strong>Shipment &amp; Logistics</strong>
                                </h6>
                            </div>
                            <table class="table table-borderless" style="width: 100%;">
                                <tr style="border-bottom: 1px solid #dee2e6; border-color: #dee2e6;">
                                    <td style="padding: 8px 5px; border: none; width: 25%; background-color: #f2f9fc;">
                                        <strong>Material Description</strong>
                                    </td>
