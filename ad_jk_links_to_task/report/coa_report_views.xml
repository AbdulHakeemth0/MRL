<!--                            </h2>-->
<!--                        </div>-->

                        <div class="row">
                            <div class="col-6" style="padding-right: 15px;">
                                <div style="font-weight: bold;">
                                    Shipper:
                                </div>
                                <hr style="border: none; border-top: 1.9px solid #555; margin: 8px 0;"/>
                                <div>
                                        <strong t-esc="doc.company_id.name"/>
                                    <br/>

                                    <t t-if="doc.company_id.street">
                                        <t t-esc="doc.company_id.street"/><br/>
                                    </t>
                                    <t t-if="doc.company_id.street2">
                                        <t t-esc="doc.company_id.street2"/><br/>
                                    </t>
                                    <t t-if="doc.company_id.city">
                                        <t t-esc="doc.company_id.city"/>,
                                    </t>
                                    <t t-if="doc.company_id.state_id.name">
                                        <t t-esc="doc.company_id.state_id.name"/>,
                                    </t>
                                    <t t-if="doc.company_id.country_id.name">
                                        <t t-esc="doc.company_id.country_id.name"/><br/>
                                    </t>

                                    <t t-if="doc.company_id.phone">
                                        Tel: <t t-esc="doc.company_id.phone"/><br/>
                                    </t>
                                    <t t-if="doc.company_id.email">
                                        Email: <t t-esc="doc.company_id.email"/><br/>
                                    </t>
                                    <t t-if="doc.company_id.website">
                                        Website: <t t-esc="doc.company_id.website"/><br/>
                                    </t>
                                </div>
                            </div>
                            <div class="col-6" style="padding-left: 15px;">
                                <div style="font-weight: bold;">
                                    Consignee / Notify:
                                </div>
                                <hr style="border: none; border-top: 1.9px solid #555; margin: 8px 0;"/>
                                <div>
                                    <strong><t t-esc="doc.consignee_info_id.name"/></strong>
                                    <br/>
                                    <t t-esc="doc.consignee_info_id.street"/>
                                    <t t-if="doc.consignee_info_id.street2">
                                        <br/>
                                        <t t-esc="doc.consignee_info_id.street2"/> |
                                    </t>
                                    <t t-if="doc.consignee_info_id.zip">
                                        PIN CODE: <t t-esc="doc.consignee_info_id.zip"/>
                                    </t>
                                    <br/>
                                    <t t-if="doc.consignee_info_id.state_id">
                                        STATE: <t t-esc="doc.consignee_info_id.state_id.name"/> |
                                    </t>
                                    <t t-if="doc.consignee_info_id.country_id">
                                        COUNTRY: <t t-esc="doc.consignee_info_id.country_id.name"/>
                                    </t>
                                    <br/>
                                    <t t-if="doc.consignee_info_id.vat">
                                        GSTIN: <t t-esc="doc.consignee_info_id.vat"/> |
                                    </t>
                                    <t t-if="doc.consignee_info_id.pan_no">
                                        PAN NO: <t t-esc="doc.consignee_info_id.pan_no"/>
                                    </t>
                                    <br/>
                                    <t t-if="doc.consignee_info_id.pan_no">
                                        IEC Code: <t t-esc="doc.consignee_info_id.iec_code"/> |
                                    </t>
                                    <t t-if="doc.consignee_info_id.contact_person_id">
                                        Contact: <t t-esc="doc.consignee_info_id.contact_person_id.name"/> |
                                    </t>
                                    PHONE: <t t-esc="doc.consignee_info_id.phone"/>
                                    <br/>
                                    EMAIL: <t t-esc="doc.consignee_info_id.email"/>
                                </div>
                            </div>
                        </div>

                        <table class="table table-borderless" style="width:100%; margin-top: 10px;">
                            <tr style="border-bottom: 1px solid #dee2e6; border-color: #dee2e6;">
                                <td style="padding: 5px; border: none; background-color: #f2f9fc;">
                                    <strong>Invoice No.</strong>
                                </td>
                                <td style="padding: 5px; border: none;">
                                    <p t-field="doc.invoice_no"/>
