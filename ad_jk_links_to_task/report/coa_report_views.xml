    <record id="certificate_analysis_report_action" model="ir.actions.report">
        <field name="name">Certificate of Analysis</field>
        <field name="model">certificate.analysis</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ad_jk_links_to_task.report_certificate_analysis</field>
        <field name="report_file">ad_jk_links_to_task.report_certificate_analysis</field>
        <field name="print_report_name">
              "%s%s-CA" % (
        object.invoice_date.strftime('') if object.invoice_date else '',
        object.number or ''
    )

        </field>
    </record>
