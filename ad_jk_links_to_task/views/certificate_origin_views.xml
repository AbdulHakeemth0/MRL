<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_certificate_origin_tree" model="ir.ui.view">
        <field name="name">certificate.origin.tree</field>
        <field name="model">certificate.origin</field>
        <field name="arch" type="xml">
            <tree>
                <field name="number"/>
                <field name="invoice_id"/>
                <field name="invoice_date"/>
                <field name="contract_no"/>
                <field name="contract_date"/>
                <field name="port_of_loading"/>
                <field name="container_no"/>
            </tree>
        </field>
    </record>

    <record id="view_certificate_origin_form" model="ir.ui.view">
        <field name="name">certificate.origin.form</field>
        <field name="model">certificate.origin</field>
        <field name="arch" type="xml">
            <form string="Certificate of Origin">
                <header>
                    <button name="%(certificate_origin_report_action)d" string="Print Certificate" type="action"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="number" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="consignee_info_id"/>
                        <field name="invoice_id"/>
                        <field name="invoice_date"/>
                        <field name="contract_no"/>
                        <field name="contract_date"/>
                        <field name="port_of_loading"/>
                        <field name="container_no"/>

                        <field name="certification_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="certificate_origin_menu" name="Certificate of Origin" parent="project.menu_project_config"/>

    <record id="certificate_origin_action" model="ir.actions.act_window">
        <field name="name">Certificate of Origin</field>
        <field name="res_model">certificate.origin</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Certificate of Origin.
            </p>
        </field>
    </record>

    <menuitem id="menu_certificate_origin" name="Certificates of Origin" parent="certificate_origin_menu"
              action="certificate_origin_action"/>
</odoo>
