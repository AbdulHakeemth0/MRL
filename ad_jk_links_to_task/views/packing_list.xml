<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="packing_list_view_list" model="ir.ui.view">
        <field name="name">packing.list.tree</field>
        <field name="model">packing.list</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partner_id"/>
                <field name="number"/>
                <field name="invoice_no"/>
                <field name="invoice_date"/>
                <field name="contract_no"/>
                <field name="contract_date"/>
                <field name="bill_of_loading_no"/>
                <field name="vessel_name"/>
                <field name="port_of_loading"/>
                <field name="final_destination"/>
            </tree>
        </field>
    </record>

    <record id="packing_list_form" model="ir.ui.view">
        <field name="name">packing.list.form</field>
        <field name="model">packing.list</field>
        <field name="arch" type="xml">
            <form string="Packing List">
                <header>
                    <button name="%(packing_list_report_action)d" string="Print Document" type="action"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                    <h1>
                        <field name="number" readonly="1"/>
                    </h1>
                </div>
                    <group>
                        <group string="SCONSIGNEE / NOTIFY: - ">
                            <field name="partner_id" widget="res_partner_many2one"
                                   context="{'show_address': 1, 'show_vat': True}"/>
<!--                            <field name="gstin"/>-->
<!--                            <field name="pan_no"/>-->
<!--                            <field name="iec_code"/>-->
<!--                            <field name="contact_person_id"/>-->
<!--                            <field name="contact_no"/>-->
<!--                            <field name="email_id"/>-->
                        </group>
                        <group string="">
                            <field name="invoice_no"/>
                            <field name="invoice_date"/>
                            <field name="contract_no"/>
                            <field name="contract_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="bill_of_loading_no"/>
                            <field name="vessel_name"/>
                            <field name="port_of_loading"/>
                            <field name="final_destination"/>
                        </group>
                        <group>
                            <field name="shipped_on_board"/>
                            <field name="voyage_no"/>
                            <field name="discharge_of_port"/>
                            <field name="packing_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="material_details" string="Materials">
                            <field name="material_ids">
                                <tree editable="bottom">
                                    <field name="sl_no"/>
                                    <field name="product_id"/>
                                    <field name="hsn_code"/>
                                    <field name="container_no"/>
                                    <field name="seal_no"/>
                                    <field name="gross_weight"/>
                                    <field name="tare_weight"/>
                                    <field name="net_weight"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="open_view_packing_list" model="ir.actions.act_window">
        <field name="name">Packing List</field>
        <field name="res_model">packing.list</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Looks like nothing is planned.
            </p>
        </field>
    </record>

    <menuitem
            id="menu_packing_list"
            name="Packing List"
            action="open_view_packing_list"
            parent="project.menu_project_management"
            sequence="1"/>

</odoo>