    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.view.inherit.ad.jk.links.to.task</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
<!--            <xpath expr="field[@name='currency_id']" position="attributes">-->
<!--                <attribute name="optional">hide</attribute>-->
<!--            </xpath>-->
<!--            <xpath expr="//div[@name='tax_totals']" position="before">-->
<!--                <div class="o_row">-->
<!--                    <label for="advance_amount"/>-->
<!--                    <div class="o_input">-->
<!--                        <field name="advance_amount" readonly="0"/>-->
<!--                    </div>-->
<!--                </div>-->
<!--            </xpath>-->
            <field name="partner_id" position="after">
                <field name="doc_created" invisible="1"/>
            </field>
<!--            <xpath expr="//header" position="inside">-->
<!--                <button name="action_create_document_po" type="object" string="Create PO"-->
<!--                        invisible="doc_created != False"/>-->
<!--            </xpath>-->
            <xpath expr="//header" position="inside">
                <button name="action_create_purchase_order"
                        string="Create PO"
                        type="object"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Invoice Document Details" name="inv">
                    <field name="related_doc_ids">
                        <tree editable="bottom">
                            <field name="invoice_id"/>
                            <field name="packing_list_id"/>
                            <field name="analysis_id"/>
                            <field name="origin_id"/>
                            <field name="freight_id"/>
                        </tree>
                    </field>
                </page>
                <page string="Document Details" name="doc">
                    <group>
                        <field name="port_of_ids"/>
                        <field name="discharge_ids"/>
                        <field name="final_ids"/>
                        <field name="delivery_ids"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="company_partner_id" invisible="1"/>
                <field name="partner_bank_id" options="{'no_open': False}"
                       context="{'default_partner_id': partner_id}"/>
                <field name="company_bank_id" options="{'no_open': False}" context="{'default_partner_id': company_partner_id}"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="agent_id"/>
                <field name="ref_no"/>
                <field name="currency_id"  readonly="state != 'draft'"/>

            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="container_qty"/>
<!--                <field name="advance_amount"/>-->
                <field name="packing"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="attachment_note"/>
            </xpath>
        </field>
    </record>
</odoo>