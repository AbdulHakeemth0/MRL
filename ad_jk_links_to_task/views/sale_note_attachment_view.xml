<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_sale_note_attachment_tree" model="ir.ui.view">
        <field name="name">sale.note.attachment.tree</field>
        <field name="model">sale.note.attachment</field>
        <field name="arch" type="xml">
            <tree string="Sale Note Attachments">
                <field name="note"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sale_note_attachment_form" model="ir.ui.view">
        <field name="name">sale.note.attachment.form</field>
        <field name="model">sale.note.attachment</field>
        <field name="arch" type="xml">
            <form string="Sale Note Attachment">
                <sheet>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sale_note_attachment" model="ir.actions.act_window">
        <field name="name">Sale Note Attachments</field>
        <field name="res_model">sale.note.attachment</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_sale_note_attachment_main"
              name="Notes"
              parent="sale.sale_order_menu"
              sequence="100"/>

    <menuitem id="menu_sale_note_attachment"
              name="Note Attachments"
              parent="menu_sale_note_attachment_main"
              action="action_sale_note_attachment"
              sequence="1"/>
</odoo>