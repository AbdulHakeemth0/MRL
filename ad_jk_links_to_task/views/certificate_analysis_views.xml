<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_certificate_analysis_form" model="ir.ui.view">
        <field name="name">certificate.analysis.form</field>
        <field name="model">certificate.analysis</field>
        <field name="arch" type="xml">
            <form string="Certificate of Analysis">
                <header>
                    <button name="%(certificate_analysis_report_action)d" string="Print Certificate" type="action"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="number" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <!-- General Information Tab -->
                        <page string="General Information">
                            <group>
                                <group>
                                    <field name="consignee_info_id"/>
                                    <field name="material_description"/>
                                    <field name="packing"/>
                                </group>
                                <group>
                                    <field name="invoice_no"/>
                                    <field name="invoice_date"/>
                                    <field name="contract_no"/>
                                    <field name="contract_date"/>
                                </group>
                            </group>
                        </page>

                        <!-- Shipment Details Tab -->
                        <page string="Shipment Details">
                            <group>
                                <group>
                                    <field name="container_no"/>
                                    <field name="seal_no"/>
                                    <field name="bill_of_lading_no"/>
                                    <field name="shipped_on_board"/>
                                </group>
                                <group>
                                    <field name="vessel_name"/>
                                    <field name="voyage_no"/>
                                    <field name="port_of_loading"/>
                                    <field name="discharge_of_port"/>
                                    <field name="final_destination"/>
                                </group>
                            </group>
                        </page>

                        <!-- Chemical Composition Tab -->
                        <page string="Chemical Composition">
                            <group>
                                <field name="chemical_elements_present"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_certificate_analysis_tree" model="ir.ui.view">
        <field name="name">certificate.analysis.tree</field>
        <field name="model">certificate.analysis</field>
        <field name="arch" type="xml">
            <tree>
                <field name="number"/>
                <field name="invoice_no"/>
                <field name="invoice_date"/>
                <field name="container_no"/>
                <field name="port_of_loading"/>
                <field name="final_destination"/>
            </tree>
        </field>
    </record>

    <menuitem id="certificate_analysis_menu" name="Certificate of Analysis" parent="project.menu_project_config"/>

    <record id="certificate_analysis_action" model="ir.actions.act_window">
        <field name="name">Certificate of Analysis</field>
        <field name="res_model">certificate.analysis</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_certificate_analysis" name="Certificates of Analysis" parent="certificate_analysis_menu"
              action="certificate_analysis_action"/>
</odoo>
