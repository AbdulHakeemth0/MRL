<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_delivery_terms_tree" model="ir.ui.view">
        <field name="name">delivery.terms.tree</field>
        <field name="model">delivery.terms</field>
        <field name="arch" type="xml">
            <tree>
                <field name="dt_name"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_delivery_terms_form" model="ir.ui.view">
        <field name="name">delivery.terms.form</field>
        <field name="model">delivery.terms</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="dt_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_delivery_terms" model="ir.actions.act_window">
        <field name="name">Delivery Terms</field>
        <field name="res_model">delivery.terms</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_delivery_terms" name="Delivery Terms"
              parent="project.menu_project_management"
              action="action_delivery_terms" sequence="1"/>
</odoo>