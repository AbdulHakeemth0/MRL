<!--&lt;!&ndash;                <field name="prefix">PO-FZC-</field>&ndash;&gt;-->
<!--                <field name="padding">4</field>-->
<!--            </record>-->
            <record id="purchase_order_fzc" model="ir.sequence">
                <field name="name">Purchase Order MRL-FZC</field>
                <field name="code">purchase.order.mrl_fzc</field>
                <field name="prefix">MRLFZC-%(y)sP</field>
                <field name="padding">4</field>
                <field name="number_next">1001</field>
            </record>


            <record id="seq_account_move_fzc" model="ir.sequence">
                <field name="name">Invoice MRL-FZC</field>
                <field name="code">account.move.mrl_fzc</field>
                <field name="prefix">INV-FZC-</field>
                <field name="padding">4</field>
            </record>
        </odoo>




