<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <odoo>
            <!-- MRL-LLC -->
            <record id="seq_sale_order_llc" model="ir.sequence">
                <field name="name">Sale Order MRL-LLC</field>
                <field name="code">sale.order.mrl_llc</field>
                <field name="prefix">MRL-%(y)sS</field>
                <field name="padding">3</field>
                 <field name="number_next">001</field>
            </record>

            <record id="purchase_order_llc" model="ir.sequence">
                <field name="name">Purchase Order MRL-LLC</field>
                <field name="code">purchase.order.mrl_llc</field>
                <field name="prefix">MRL-%(y)sP</field>
                <field name="padding">3</field>
                <field name="number_next">001</field>
            </record>

            <record id="seq_account_move_llc" model="ir.sequence">
                <field name="name">Invoice MRL-LLC</field>
                <field name="code">account.move.mrl_llc</field>
                <field name="prefix">INV-LLC-</field>
                <field name="padding">4</field>
            </record>

            <!-- MRL-FZC -->
            <record id="seq_sale_order_fzc" model="ir.sequence">
                <field name="name">Sale Order MRL-FZC</field>
                <field name="code">sale.order.mrl_fzc</field>
                <field name="prefix">MRLFZC-%(y)sS</field>
                <field name="padding">4</field>
                <field name="number_next">1001</field>
            </record>

<!--            <record id="seq_purchase_order_fzc" model="ir.sequence">-->
<!--                <field name="name">Purchase Order MRL-FZC</field>-->
<!--                <field name="code">purchase.order.mrl_fzc</field>-->
