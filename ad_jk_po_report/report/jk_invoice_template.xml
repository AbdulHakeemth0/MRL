                                    <span t-field="o.amount_residual"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <hr style="border: none; border-top: 1px solid #D3D3D3; margin-top: 70px; font-size: 10px;"/>

