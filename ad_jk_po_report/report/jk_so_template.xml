<!--                                    <span t-esc="abs(doc.amount_paid)"-->
<!--                                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>-->
<!--                                </td>-->
<!--                            </tr>-->
                            <tr>
                                <td style="padding: 5px; border: none; text-align: right; font-weight: bold;">
                                    AMOUNT
                                </td>
                                <td style="padding: 5px; border: none; text-align: right; font-weight: bold;">
                                    <span t-esc="abs(doc.amount_paid - doc.amount_total)"
                                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <hr style="border: none; border-top: 1.9px solid #555; margin: 8px 0;"/>

                <div style="margin-top: 25px;">
                    <div style="font-weight: bold; margin-bottom: 5px;">
                        Terms &amp; Conditions
                    </div>

                    <table class="table table-borderless" style="width: 100%;">
                        <tr style="border-bottom: 1px solid #dee2e6;">
                            <td style="padding: 8px 5px; background-color: #f2f9fc; width: 15%;"><strong>Payment Terms</strong></td>
