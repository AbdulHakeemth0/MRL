                <!-- Is there a discount on at least one line? -->
                <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

                <div class="oe_structure"></div>

                <table class="table table-borderless" style="width:100%; margin-top: 10px;">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="background-color: #f2f9fc;">
                        <tr style="border-bottom: 1px solid #dee2e6; border-color: #dee2e6;">
                            <th class="text-center" style="border: none;">
                                <b>SI NO</b>
                            </th>
                            <th style="border: none;" class="text-start">MATERIAL DESCRIPTION</th>

                            <th style="border: none;" class="text-start">HSN CODE</th>
                            <th style="border: none;" class="text-start">QUANTITY (+/-10%)</th>
                            <th style="border: none;" class="text-start">NO OF CONTAINERS</th>
                            <th style="border: none;" class="text-start">UNIT PRICE</th>
                            <th style="border: none;" class="text-start">PACKING</th>
                            <th style="border: none;" class="text-start">AMOUNT</th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-set="currency" t-value="doc.currency_id or doc.company_id.currency_id"/>
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="i" t-value="0"/>
                        <t t-foreach="lines_to_report" t-as="line">
                            <t t-set="i" t-value="i + 1"/>

                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''"
                            style="border-bottom: 1px solid #dee2e6; border-color: #dee2e6;">
                                <t t-if="not line.display_type">
                                    <td style="border: none;">
                                        <t t-esc="i"/>
                                    </td>

                                    <td style="border: none;" name="td_name">
                                        <span t-field="line.name">Bacon Burger</span>
                                        <br/>
                                        <span t-field="line.attachment_note"></span>
                                    </td>

                                    <td style="border: none;">
                                        <span t-field="line.product_id.hsn_code"/>
                                    </td>

                                    <td style="border: none;" name="td_quantity">
                                        <span t-esc="int(line.product_uom_qty)">3</span>
                                        <span t-field="line.product_uom">units</span>
                                        <span t-if="line.product_packaging_id">
                                            (
                                            <span t-field="line.product_packaging_qty"
                                                  t-options='{"widget": "integer"}'/>
                                            <span t-field="line.product_packaging_id"/>)
                                        </span>
                                    </td>
                                    <td style="border: none;">
                                        <span t-field="line.container_qty"/>
                                    </td>
                                    <td style="border: none;">
                                        <span t-field="line.price_unit"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td style="border: none;">
                                        <span t-field="line.packing"/>
                                    </td>
                                    <td style="border: none;" t-if="not line.is_downpayment" name="td_subtotal"
                                        class="o_price_total">
                                        <span t-field="line.price_subtotal"></span>
                                    </td>
                                </t>
                            </tr>
                        </t>
                        <tr style="border-bottom: 1px solid #dee2e6; border-color: #dee2e6;">
                            <td/>
                            <td style="border: none; font-weight:bold">
                                TOTAL
                            </td>
                            <td/>
                            <td style="border: none; font-weight:bold">
                                <span t-esc="sum(lines_to_report.mapped('product_uom_qty'))">3</span>
                                <span t-field="line.product_uom">units</span>
                            </td>
                            <td/>
                            <td/>
                            <td class="o_price_total" style="border: none; font-weight:bold">
<!--                                <t t-set="sum(lines_to_report.mapped('price_subtotal'))" t-as="total_value"/>-->
                                <span t-field="doc.amount_total"></span>
<!--                                <t t-esc="sum(lines_to_report.mapped('price_subtotal'))"/>-->
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="row" style="margin-top: 20px;">
                    <div class="col-6" style="padding-right: 15px;">
                        <div style="font-weight: bold;">
