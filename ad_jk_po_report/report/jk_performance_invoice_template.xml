                            Shipper:
                        </div>
                        <hr style="border: none; border-top: 1.9px solid #555; margin: 8px 0;"/>
                        <div>
                            <strong t-esc="o.company_id.name"/>
                            <br/>

                            <t t-if="o.company_id.street">
                                <t t-esc="o.company_id.street"/>
                                <br/>
                            </t>
                            <t t-if="o.company_id.street2">
                                <t t-esc="o.company_id.street2"/>
                                <br/>
                            </t>
                            <t t-if="o.company_id.city">
                                <t t-esc="o.company_id.city"/>,
                            </t>
                            <t t-if="o.company_id.state_id.name">
                                <t t-esc="o.company_id.state_id.name"/>,
                            </t>
                            <t t-if="o.company_id.country_id.name">
                                <t t-esc="o.company_id.country_id.name"/>
                                <br/>
                            </t>

                            <t t-if="o.company_id.phone">
                                Tel:
                                <t t-esc="o.company_id.phone"/>
                                <br/>
                            </t>
                            <t t-if="o.company_id.email">
                                Email:
                                <t t-esc="o.company_id.email"/>
                                <br/>
                            </t>
                            <t t-if="o.company_id.website">
                                Website:
                                <t t-esc="o.company_id.website"/>
                                <br/>
                            </t>
                        </div>
                    </div>
                    <div class="col-6"/>
                </div>

                <div class="row">
                    <div class="col-6" style="padding-right: 15px; font-size: 10px;">
                        <div style="font-weight: bold;">
                            Consignee / Notify:
                        </div>
                        <hr style="border: none; border-top: 1.9px solid #555; margin: 8px 0;"/>
                        <div>
                            <strong>
                                <t t-esc="o.partner_id.name"/>
                            </strong>
                            <br/>
                            <t t-esc="o.partner_id.street"/>
                            <t t-if="o.partner_id.street2">
                                <br/>
                                <t t-esc="o.partner_id.street2"/>
                            </t>
                            <br/>
                            <t t-if="o.partner_id.state_id">
                                STATE:
                                <t t-esc="o.partner_id.state_id.name"/>
                            </t>
                            <t t-if="o.partner_id.country_id">
                                , COUNTRY:
                                <t t-esc="o.partner_id.country_id.name"/>
                            </t>
                            <br/>
                            GSTIN:
                            <t t-esc="o.partner_id.vat"/>
                            | PAN NO:
                            <t t-esc="o.partner_id.pan_no"/>
                            <br/>
                            IEC Code:
                            <t t-esc="o.partner_id.iec_code"/>
                            |
                            <t t-if="o.partner_id.contact_person_id">
                                Contact:
                                <t t-esc="o.partner_id.contact_person_id.name"/>
                            </t>
                            <br/>
                            Email:
                            <t t-esc="o.partner_id.email"/>
