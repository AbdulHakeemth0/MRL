                            <th class="text-start" width="10%">Net Wt.(MT)</th>
                            <th class="text-start" width="10%">Unit Price</th>
                            <!--                            <th class="text-start">Vat</th>-->
                            <th class="text-start" width="10%">Amount</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-set="i" t-value="0"/>
                        <t t-set="gross_wt" t-value="0"/>
                        <t t-set="net_wt" t-value="0"/>
                        <t t-set="total" t-value="0"/>

                        <t t-foreach="o._jk_get_proforma_report_lines()" t-as="line">
                                <t t-set="i" t-value="i + 1"/>
                                <t t-set="gross_wt" t-value="gross_wt + line['gross_weight']"/>
                                <t t-set="net_wt" t-value="net_wt + line['net_weight']"/>
                                <t t-set="line_amount" t-value="line['price_subtotal']"/>
                                <t t-set="total" t-value="total + line_amount"/>

                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <!--                                <td><t t-esc="i"/></td>-->
                                    <td style="text-align: center;">
                                        <t t-esc="i"/>
                                    </td>
<!--                                    <td style="border: none;" name="td_name">-->
<!--                                        <span t-field="line.name"></span>-->
<!--                                    </td>-->

                                                                    <td>

                                                                        <span t-esc="line['product_name']"/>
                                                                    </td>

                                    <td>
                                        <span t-esc="line['product_uom_qty']"/>
                                    </td>

                                    <td>
                                        <span t-esc="line['container_qty']"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="'%.3f' % line['gross_weight']"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="'%.3f' % line['net_weight']"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="line['price_unit']"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>

                                    <!--                                <td class="text-end">-->
                                    <!--                                    <span t-field="o.amount_tax_signed"-->
                                    <!--                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>-->
                                    <!--                                </td>-->

                                    <!-- Line subtotal (untaxed total) -->
                                    <td style="text-align: right;">

                                        <t t-esc="'%.2f' % line['price_subtotal']"/>
                                        <t t-esc="o.currency_id.symbol"/>
                                    </td>
                                </tr>
                        </t>

                        <!-- TOTAL ROW -->

                        <!--                        <hr style="border: none; border-top: 1px solid #D3D3D3; margin-top: 15px;"/>-->
                        <tr>
                            <td style="font-weight:bold">TOTAL</td>
                            <td></td>
                            <td></td>
                            <td></td>
