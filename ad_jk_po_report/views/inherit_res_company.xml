<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_res_company_form_inherit_signatures" model="ir.ui.view">
            <field name="name">res.company.form.signatures</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='general_info']" position="after">
                        <page string="Company Details" name="company_info">
                            <group string="Signature / Stamp Configuration" colspan="4">
                                <group>
                                    <field name="show_signature_stamp_1"/>
                                    <field name="signature_stamp_1" widget="image" class="oe_avatar"
                                           invisible="show_signature_stamp_1 == False"/>
                                </group>
                                <group>
                                    <field name="show_signature_stamp_2"/>
                                    <field name="signature_stamp_2" widget="image" class="oe_avatar"
                                           invisible="show_signature_stamp_2 == False"/>
                                </group>
                            </group>

<!--                            <group string="General Signature" colspan="4">-->
<!--                                <field name="signature" widget="image" class="oe_avatar"/>-->
<!--                            </group>-->
                        </page>
                </xpath>
            </field>
        </record>
    </data>

</odoo>